{
  "name": "slidev-theme-artm",
  "version": "0.1.0",
  "description": "Thème Slidev officiel de l'ARTM – Autorité Régionale de Transport Métropolitain",
  "keywords": [
    "slidev-theme",
    "slidev",
    "artm"
  ],
  "license": "UNLICENSED",
  "slidev": {
    "colorSchema": "light",
    "defaults": {
      "aspectRatio": "16/9",
      "canvasWidth": 980,
      "transition": "fade"
    }
  },
  "engines": {
    "slidev": ">=0.52.0"
  },
  "scripts": {
    "dev": "slidev --open false --remote --port 3030 slides.md",
    "build": "slidev build slides.md --routerMode hash",
    "build:clean": "slidev build slides.md --routerMode hash --without-notes",
    "export": "slidev export slides.md",
    "format:check": "prettier --check .",
    "format": "prettier --write .",
    "lint:theme": "node scripts/check-theme.mjs",
    "lint:vue": "eslint \"layouts/**/*.vue\" \"components/**/*.vue\"",
    "lint:css": "stylelint \"styles/**/*.css\" \"layouts/**/*.vue\" \"components/**/*.vue\"",
    "typecheck": "vue-tsc --noEmit",
    "check": "node scripts/check-theme.mjs && prettier --check . && eslint \"layouts/**/*.vue\" \"components/**/*.vue\" && stylelint \"styles/**/*.css\" \"layouts/**/*.vue\" \"components/**/*.vue\" && vue-tsc --noEmit && slidev build slides.md --routerMode hash"
  },
  "dependencies": {
    "@slidev/cli": "^52.16.0",
    "@slidev/theme-default": "^0.25.0",
    "@slidev/theme-seriph": "^0.25.0"
  },
  "devDependencies": {
    "@typescript-eslint/parser": "^8.70.0",
    "eslint": "^9.21.0",
    "eslint-plugin-vue": "^9.32.0",
    "postcss-html": "^1.8.0",
    "prettier": "^3.5.3",
    "prettier-plugin-slidev": "^1.0.5",
    "stylelint": "^16.14.1",
    "stylelint-config-standard": "^37.0.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.70.0",
    "vue-eslint-parser": "^10.4.1",
    "vue-tsc": "^2.2.8"
  }
}
