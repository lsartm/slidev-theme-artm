{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "jsx": "preserve",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": ["components/**/*.vue", "layouts/**/*.vue", "*.ts", "*.d.ts"],
  "exclude": ["dist", "node_modules"]
}
